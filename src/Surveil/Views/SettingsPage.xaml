<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Surveil.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled">

        <Grid Padding="36,24,36,36">
            <Grid MaxWidth="1000"
                  HorizontalAlignment="Stretch">

                <StackPanel Spacing="4">

                    <TextBlock Text="Settings"
                               Style="{StaticResource TitleTextBlockStyle}"
                               Margin="0,0,0,20" />

                    <TextBlock Text="General"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0,0,0,8" />

                    <controls:SettingsCard Header="Launch on startup"
                                           Description="{Binding LaunchOnStartupDescription}"
                                           IsEnabled="{Binding IsLaunchOnStartupToggleEnabled}">
                        <ToggleSwitch AutomationProperties.AutomationId="LaunchOnStartupToggle"
                                      IsOn="{Binding LaunchOnStartup, Mode=TwoWay}"
                                      MinWidth="0" />
                    </controls:SettingsCard>

                    <TextBlock Text="Video provider"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0,28,0,8" />

                    <controls:SettingsCard Header="Provider"
                                           Description="Choose which system provides your camera feeds.">
                        <ComboBox AutomationProperties.AutomationId="ProviderComboBox"
                                  ItemsSource="{Binding AvailableProviders}"
                                  SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  Width="320" />
                    </controls:SettingsCard>

                    <StackPanel Visibility="{Binding UnifiProviderVisibility}"
                                Spacing="4">

                        <TextBlock Text="UniFi Protect connection"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Margin="0,28,0,8" />

                        <controls:SettingsCard Header="Base URL"
                                               Description="Address of your UniFi Protect controller.">
                            <TextBox AutomationProperties.AutomationId="BaseUrlTextBox"
                                     Text="{Binding BaseUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     PlaceholderText="https://192.168.0.1"
                                     Width="320" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="API key"
                                               Description="Used to authenticate with the controller.">
                            <TextBox AutomationProperties.AutomationId="ApiKeyTextBox"
                                     Text="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     PlaceholderText="Your UniFi Protect API key"
                                     Width="320" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="Snapshot path"
                                               Description="Where event snapshots are written. Leave empty to use the default path.">
                            <TextBox AutomationProperties.AutomationId="SnapshotPathTextBox"
                                     Text="{Binding SnapshotPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     PlaceholderText="Default path"
                                     Width="320" />
                        </controls:SettingsCard>
                    </StackPanel>

                    <InfoBar AutomationProperties.AutomationId="SettingsErrorInfoBar"
                             IsOpen="{Binding ShowError, Mode=TwoWay}"
                             Severity="Error"
                             Title="Not saved"
                             Message="{Binding ErrorMessage}"
                             IsClosable="True"
                             Margin="0,16,0,0" />

                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
